# Git
.git
.gitignore
.gitattributes

# 数据目录（运行时由 volume 挂载，不应打进镜像）
data/
**/synced_notes/
**/thumbnails/
*.sqlite
*.sqlite3
*.db

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node / 前端构建缓存
node_modules/
frontend/dist/
frontend/.vite/

# 环境变量（含密钥，不应打进镜像）
.env
.env.*
!.env.example

# IDE / 工具配置
.vscode/
.idea/
.trae/
*.swp
*.swo

# 文档和示例（不需要进镜像）
*.md
docs/

# Docker 自身
Dockerfile*
docker-compose*.yml
.dockerignore

# 构建产物
*.log
*.tmp
