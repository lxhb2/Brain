# ---- Brain 配置 ----

# LLM API Key（不填则进入 demo 模式：仍可端到端运行，但 OCR/问答为模拟数据）
# 默认示例保留云端服务；本地 LM Studio 可换成 http://host.docker.internal:1234/v1
OPENAI_API_KEY=sk-你的key

# OpenAI 兼容端点
# 硅基流动:  https://api.siliconflow.cn/v1
# OpenAI:    https://api.openai.com/v1
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
# LM Studio: http://host.docker.internal:1234/v1（API Key 可填任意非空字符串）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 视觉 OCR 模型（需支持 image_url 多模态）
# 硅基流动推荐: Pro/moonshotai/Kimi-K2.6 / Qwen/Qwen3-VL-32B-Instruct
# LM Studio 示例: qwen3.5-4b
LLM_MODEL=Pro/moonshotai/Kimi-K2.6

# 百度智能云 OCR（手写文字识别，专用接口，准确率更高）
# 申请：https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
# 留空则不启用百度 OCR
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENABLED=false

# 纯文本问答模型（RAG 用，便宜快速；为空则回退到 LLM_MODEL）
# 硅基流动推荐: deepseek-ai/DeepSeek-V3.2 / Qwen/Qwen3.6-27B
# LM Studio 示例: qwen3.5-4b
QA_MODEL=deepseek-ai/DeepSeek-V3.2

# Embedding 模型
# 硅基流动推荐: BAAI/bge-m3 (1024 维) / BAAI/bge-large-zh-v1.5 (1024 维)
# LM Studio 示例: text-embedding-nomic-embed-text-v1.5 (768 维)
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding 向量维度（必须与所选模型一致）
# BAAI/bge-m3 = 1024, text-embedding-3-small = 1536, text-embedding-3-large = 3072
# text-embedding-nomic-embed-text-v1.5 = 768
EMBEDDING_DIM=1024

# 监听目录（相对 backend 工作目录；容器内由 compose 覆盖为绝对路径）
SYNCED_NOTES_ROOT=data/synced_notes
THUMBNAIL_DIR=data/thumbnails
MARKDOWN_BUNDLE_DIR=data/markdown_bundles
DB_PATH=data/brain.db

# 候选链接权重（α 语义 / β 关键词 / γ 时间）
LINK_ALPHA=0.6
LINK_BETA=0.3
LINK_GAMMA=0.1
LINK_WEIGHT_THRESHOLD=0.35

# ---- 运维（可选）----

# API Key 认证（公网部署强烈建议设置；本地局域网用可留空）
# 设置后所有 /api/* 请求需带 `X-API-Key: <key>` header 或 ?api_key=<key> query
BRAIN_API_KEY=


# ---- 数据目录 ----

# Docker 宿主机上的持久化目录。
# WSL 长期部署建议使用 Linux 文件系统下的固定路径，例如：
#   BRAIN_DATA_DIR=/home/<你的用户名>/.local/var/brain
# 该路径保存在 WSL 的 ext4.vhdx 中；如果把 Ubuntu-22.04 移到 G:\WSL，
# 数据实际就随 VHDX 存放在 G 盘。不要使用 /mnt/g 作为应用数据目录。
# 默认保持与旧版本兼容：
#   BRAIN_DATA_DIR=./data
BRAIN_DATA_DIR=./data
# 时区（容器内用；影响日志时间和每日归纳的"今天"判定）
TZ=Asia/Shanghai

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# Uvicorn worker 数（OCR 是 IO 密集，1 个够用；
# 注意：代码未做多 worker 安全，watcher/scheduler/队列都是进程内状态，请勿调高）
UVICORN_WORKERS=1

# 轻量化运行参数（适合 WSL / 小内存服务器）
OCR_WORKERS=1
OCR_PAGE_PARALLELISM=2
PDF_RENDER_ZOOM=1.25
