# ---- Brain 配置 ----

# OpenAI API Key（不填则进入 demo 模式：仍可端到端运行，但 OCR/问答为模拟数据）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 自定义 OpenAI 兼容端点（可选，用于代理或第三方兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 视觉 OCR / 对话模型
LLM_MODEL=gpt-4o

# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small

# 监听目录（相对 backend 工作目录；容器内由 compose 覆盖为绝对路径）
SYNCED_NOTES_ROOT=data/synced_notes
THUMBNAIL_DIR=data/thumbnails
DB_PATH=data/brain.db

# 候选链接权重（α 语义 / β 关键词 / γ 时间）
LINK_ALPHA=0.6
LINK_BETA=0.3
LINK_GAMMA=0.1
LINK_WEIGHT_THRESHOLD=0.35
