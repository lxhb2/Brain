# ---- Brain 配置 ----

# LLM API Key（不填则进入 demo 模式：仍可端到端运行，但 OCR/问答为模拟数据）
# 默认使用硅基流动 SiliconFlow（OpenAI 兼容），也可换成 OpenAI / 智谱 / 通义等
OPENAI_API_KEY=sk-你的key

# OpenAI 兼容端点
# 硅基流动:  https://api.siliconflow.cn/v1
# OpenAI:    https://api.openai.com/v1
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 视觉 OCR 模型（需支持 image_url 多模态）
# 硅基流动推荐: Qwen/Qwen3-VL-32B-Instruct / Qwen/Qwen3-VL-8B-Instruct
LLM_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 纯文本问答模型（RAG 用，便宜快速；为空则回退到 LLM_MODEL）
# 硅基流动推荐: deepseek-ai/DeepSeek-V3.2 / Qwen/Qwen3.6-27B
QA_MODEL=deepseek-ai/DeepSeek-V3.2

# Embedding 模型
# 硅基流动推荐: BAAI/bge-m3 (1024 维) / BAAI/bge-large-zh-v1.5 (1024 维)
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding 向量维度（必须与所选模型一致）
# BAAI/bge-m3 = 1024, text-embedding-3-small = 1536, text-embedding-3-large = 3072
EMBEDDING_DIM=1024

# 监听目录（相对 backend 工作目录；容器内由 compose 覆盖为绝对路径）
SYNCED_NOTES_ROOT=data/synced_notes
THUMBNAIL_DIR=data/thumbnails
DB_PATH=data/brain.db

# 候选链接权重（α 语义 / β 关键词 / γ 时间）
LINK_ALPHA=0.6
LINK_BETA=0.3
LINK_GAMMA=0.1
LINK_WEIGHT_THRESHOLD=0.35
